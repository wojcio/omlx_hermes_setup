# ==============================================================================
# Konfiguracja zdalnego serwera oMLX dla agenta Hermes
# ==============================================================================
# Poniższy adres IP reprezentuje prywatny serwer oMLX właściciela repozytorium,
# dostępny w prywatnej sieci (Tailscale VPN): 100.123.37.101
#
# JEŻELI POSIADASZ WŁASNY SERWER oMLX:
# Podmień poniższy adres na własne IP Twojego serwera (np. w sieci lokalnej LAN lub Tailscale).
# ==============================================================================
OMLX_IP=100.123.37.101
OMLX_PORT=8000

# Klucz API serwera oMLX do autoryzacji zapytań Hermesa (skopiuj ten plik jako .env i wpisz swój klucz):
OMLX_API_KEY=YOUR_OMLX_API_KEY

# Opcjonalne wymuszenie trybu (odkomentuj, aby wymusić tryb zdalny nawet przy lokalnym oMLX):
# OMLX_MODE=remote
